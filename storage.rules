rules_version = '2';

// Cloud Storage NO se usa: en el plan gratuito Spark no está disponible desde
// febrero de 2026 (ADR-018). Las fotos de las actas se guardan en Firestore
// (colección fotos, ver firestore.rules). Si este archivo se desplegara por
// error, todo queda cerrado.
service firebase.storage {
  match /b/{bucket}/o {
    match /{todo=**} {
      allow read, write: if false;
    }
  }
}
